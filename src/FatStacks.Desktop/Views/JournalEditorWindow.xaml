<Window x:Class="FatStacks.Desktop.Views.JournalEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Journal entry" Icon="/FatStacks.Desktop;component/Assets/ApplicationIcon.ico" Width="940" Height="680" MinHeight="500" MinWidth="780" WindowStartupLocation="CenterOwner" Background="White" FontFamily="Segoe UI" FontSize="13" KeyDown="DialogKeyDown" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.AutomationId="JournalEditor">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Grid.Row="0" IsEnabled="{Binding Idle}">
   <DockPanel Margin="0,0,0,16"><TextBlock Text="Journal entry" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding Currency}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><Label Content="_Date" Target="{Binding ElementName=AccountingDateInput}"/><DatePicker x:Name="AccountingDateInput" SelectedDate="{Binding AccountingDate}" DateValidationError="DateInvalid" PreviewTextInput="DateShortcutInput" ToolTip="Date shortcuts: - previous day, + next day, T today (book time zone)" AutomationProperties.Name="Accounting date" AutomationProperties.AutomationId="AccountingDate"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,16,0"><Label Content="Bank posting date"/><DatePicker x:Name="BankDateInput" SelectedDate="{Binding BankPostingDate}" DateValidationError="DateInvalid" PreviewTextInput="DateShortcutInput" ToolTip="Date shortcuts: - previous day, + next day, T today (book time zone)" AutomationProperties.Name="Bank posting date" AutomationProperties.AutomationId="BankPostingDate"/></StackPanel>
    <StackPanel Grid.Column="2"><Label Content="_Payee" Target="{Binding ElementName=PayeeInput}"/><TextBox x:Name="PayeeInput" Text="{Binding Payee,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="JournalPayee"/></StackPanel>
   </Grid>
   <Label Content="D_escription" Target="{Binding ElementName=DescriptionInput}" Margin="0,10,0,0"/><TextBox x:Name="DescriptionInput" Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="JournalDescription"/>
  </StackPanel>
  <DockPanel Grid.Row="1" Margin="0,20,0,0" IsEnabled="{Binding Idle}">
   <Grid DockPanel.Dock="Top" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="Account" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Debit" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Credit" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold"/></Grid>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" IsTabStop="False">
    <ItemsControl Focusable="False" IsTabStop="False" x:Name="PostingRows" ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate>
     <Grid Margin="0,0,0,8" AutomationProperties.Name="{Binding Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="100"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
      <ContentControl Focusable="False" IsTabStop="False" Loaded="AccountHostLoaded" Margin="0,0,8,0"/>
      <TextBox Grid.Column="1" Text="{Binding Debit,UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="DebitLostFocus" Margin="0,0,8,0" AutomationProperties.Name="Debit" AutomationProperties.AutomationId="{Binding DebitControlId}"/>
      <TextBox Grid.Column="2" Text="{Binding Credit,UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="CreditLostFocus" Margin="0,0,8,0" PreviewKeyDown="CreditKeyDown" AutomationProperties.Name="Credit" AutomationProperties.AutomationId="{Binding CreditControlId}"/>
      <TextBlock Grid.Column="3" Text="{Binding StatusName}" VerticalAlignment="Center"/>
      <Button Grid.Column="4" Content="×" Padding="0" FontSize="18" IsTabStop="False" IsEnabled="{Binding DataContext.CanRemoveLine,RelativeSource={RelativeSource AncestorType=Window}}" Click="RemoveClicked" ToolTip="Remove posting (Ctrl+Shift+Delete; at least two required)" AutomationProperties.Name="Remove posting"/>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </ScrollViewer>
  </DockPanel>
  <StackPanel Grid.Row="2">
   <Button Content="+ Add posting" HorizontalAlignment="Left" Click="AddClicked" IsEnabled="{Binding Idle}" AutomationProperties.AutomationId="AddJournalLine" Margin="0,8"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="JournalStatus"/>
   <ScrollViewer x:Name="ErrorScroll" MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" IsTabStop="False"><ItemsControl Focusable="False" IsTabStop="False" ItemsSource="{Binding Errors}" AutomationProperties.AutomationId="JournalErrors"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Foreground="#B42318" TextWrapping="Wrap"><Run Text="{Binding LineOrder,StringFormat=Line {0} · }"/><Run Text="{Binding Field}"/><Run Text=": "/><Run Text="{Binding Message}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" IsEnabled="{Binding Idle}">
    <Button Content="Cancel" Click="CancelClicked" AutomationProperties.AutomationId="CancelJournal"/>
    <Button Content="_Continue" Click="ContinueClicked" AutomationProperties.AutomationId="ContinueJournal" ToolTip="Save and start another entry with the same date"/>
    <Button Content="_Save" Click="SaveClicked" AutomationProperties.AutomationId="SaveJournal" ToolTip="Save (Ctrl+Enter)"/>
   </StackPanel>
  </StackPanel>
 </Grid>
</Window>
