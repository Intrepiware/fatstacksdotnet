<Window x:Class="FatStacks.Desktop.Views.DeleteEntryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Delete journal entry" Icon="/FatStacks.Desktop;component/Assets/ApplicationIcon.ico" Width="740" SizeToContent="Height" MinWidth="640" MaxHeight="680" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White" FontFamily="Segoe UI" FontSize="13" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.AutomationId="DeleteEntry">
 <Window.Resources>
  <Style x:Key="DialogButton" TargetType="Button">
   <Setter Property="Background" Value="#F7F9FB"/><Setter Property="Foreground" Value="#23384E"/><Setter Property="BorderBrush" Value="#CFD8E1"/><Setter Property="Padding" Value="20,10"/><Setter Property="MinWidth" Value="100"/><Setter Property="Margin" Value="8,0,0,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#225B88"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#B42318" Margin="26,0,26,10" AutomationProperties.AutomationId="DeleteStatus"/>
   <Border Background="#F7F9FB" BorderBrush="#DCE3EA" BorderThickness="0,1,0,0" Padding="20,16">
    <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right">
     <Button x:Name="CancelButton" Content="_Cancel" IsCancel="True" IsDefault="True" Style="{StaticResource DialogButton}" AutomationProperties.AutomationId="CancelDelete"/>
     <Button Content="_Delete" Click="DeleteClicked" Background="#B42318" Foreground="White" BorderBrush="#B42318" Style="{StaticResource DialogButton}" AutomationProperties.AutomationId="ConfirmDelete"/>
    </StackPanel>
   </Border>
  </StackPanel>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="520">
   <StackPanel Margin="26,24,26,22">
   <TextBlock Text="Delete journal entry?" FontSize="23" FontWeight="SemiBold"/>
   <TextBlock Text="This will remove the entry and all its postings." Foreground="#748498" Margin="0,8,0,20" TextWrapping="Wrap"/>
   <Border Background="#F8FAFC" BorderBrush="#DCE3EA" BorderThickness="1" CornerRadius="6" Padding="16">
    <StackPanel>
     <TextBlock x:Name="JournalDate" Foreground="#748498" FontSize="12" AutomationProperties.AutomationId="DeleteEntryDate"/>
     <TextBlock x:Name="Preview" FontSize="16" Margin="0,5,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="DeletePreview"><Run x:Name="PayeeText" FontWeight="SemiBold"/><Run x:Name="SeparatorText"/><Run x:Name="DescriptionText" FontStyle="Italic" Foreground="#516579"/></TextBlock>
     <TextBlock x:Name="BankDate" Foreground="#748498" FontSize="12" Margin="0,5,0,0" AutomationProperties.AutomationId="DeleteBankDate"/>
     <Grid Margin="0,14,0,3" TextElement.Foreground="#748498" TextElement.FontSize="11">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <TextBlock Text="Account"/><TextBlock Grid.Column="1" Text="C" TextAlignment="Center" ToolTip="Reconciliation status" AutomationProperties.Name="Reconciliation status"/><TextBlock Grid.Column="2" Text="Debit" TextAlignment="Right"/><TextBlock Grid.Column="3" Text="Credit" TextAlignment="Right"/>
     </Grid>
     <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Lines" AutomationProperties.AutomationId="DeleteLines"><ItemsControl.ItemTemplate><DataTemplate>
       <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Account}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Account}" Margin="0,0,12,0"/>
        <TextBlock Grid.Column="1" Text="{Binding StatusSymbol}" ToolTip="{Binding Status}" AutomationProperties.Name="{Binding Status}" TextAlignment="Center" Background="Transparent"/>
        <TextBlock Grid.Column="2" Text="{Binding DebitText}" TextAlignment="Right" FontFamily="Consolas"/>
        <TextBlock Grid.Column="3" Text="{Binding CreditText}" TextAlignment="Right" FontFamily="Consolas"/>
       </Grid>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </ScrollViewer>
    </StackPanel>
   </Border>
   </StackPanel>
  </ScrollViewer>
 </DockPanel>
</Window>
