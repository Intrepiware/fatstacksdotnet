<Window x:Class="FatStacks.Desktop.Views.DeleteEntryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Delete journal entry" Width="780" Height="460" MinWidth="640" MinHeight="350" WindowStartupLocation="CenterOwner" AutomationProperties.AutomationId="DeleteEntry">
 <DockPanel Margin="24">
  <StackPanel DockPanel.Dock="Top"><TextBlock Text="Delete the whole journal entry?" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="Preview" TextWrapping="Wrap" Margin="0,12" AutomationProperties.AutomationId="DeletePreview"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.AutomationId="DeleteStatus"/><StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="CancelButton" Content="Cancel" IsCancel="True" AutomationProperties.AutomationId="CancelDelete"/><Button Content="Delete entry" Click="DeleteClicked" AutomationProperties.AutomationId="ConfirmDelete"/></StackPanel></StackPanel>
  <DataGrid x:Name="Lines" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.AutomationId="DeleteLines"><DataGrid.Columns><DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="*"/><DataGridTextColumn Header="Debit" Binding="{Binding Debit}" Width="110"/><DataGridTextColumn Header="Credit" Binding="{Binding Credit}" Width="110"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/></DataGrid.Columns></DataGrid>
 </DockPanel>
</Window>
