<Window x:Class="FatStacks.Desktop.Views.ConnectionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Connections — Fat Stacks.NET" Width="780" Height="650" MinWidth="700" MinHeight="600" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" AutomationProperties.AutomationId="ConnectionWindow">
 <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel><Button DockPanel.Dock="Bottom" Content="New profile" Command="{Binding NewCommand}" Margin="0,10,0,0" AutomationProperties.AutomationId="NewProfile"/>
   <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" DisplayMemberPath="FriendlyName" IsEnabled="{Binding Idle}" AutomationProperties.Name="Saved profiles" AutomationProperties.AutomationId="Profiles"/>
  </DockPanel>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="Database connections" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <StackPanel IsEnabled="{Binding Idle}">
     <Label Content="Friendly name" Target="{Binding ElementName=Friendly}"/><TextBox x:Name="Friendly" Text="{Binding FriendlyName,UpdateSourceTrigger=PropertyChanged}" Padding="6" AutomationProperties.AutomationId="FriendlyName"/>
     <Label Content="Server (for example localhost,1433)" Target="{Binding ElementName=Server}"/><TextBox x:Name="Server" Text="{Binding Server,UpdateSourceTrigger=PropertyChanged}" Padding="6" AutomationProperties.AutomationId="Server"/>
     <Label Content="Database" Target="{Binding ElementName=Database}"/><TextBox x:Name="Database" Text="{Binding Database,UpdateSourceTrigger=PropertyChanged}" Padding="6" AutomationProperties.AutomationId="Database"/>
     <CheckBox x:Name="IntegratedCredentials" Content="Use Windows integrated credentials" IsChecked="{Binding Integrated}" Margin="0,12,0,4" AutomationProperties.AutomationId="Integrated"/>
    <StackPanel>
     <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
      <DataTrigger Binding="{Binding IsChecked, ElementName=IntegratedCredentials}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
     </Style.Triggers></Style></StackPanel.Style>
     <Label Content="SQL username" Target="{Binding ElementName=UserName}"/><TextBox x:Name="UserName" Text="{Binding UserName,UpdateSourceTrigger=PropertyChanged}" Padding="6" AutomationProperties.AutomationId="UserName"/>
     <Label Content="SQL password" Target="{Binding ElementName=Password}"/><PasswordBox x:Name="Password" PasswordChanged="PasswordChanged" Padding="6" AutomationProperties.AutomationId="Password"/>
    </StackPanel>
     <CheckBox Content="Permit an unverified server certificate" IsChecked="{Binding TrustCertificate}" Margin="0,12,0,4"/>
     <CheckBox Content="Allow unencrypted SQL transport if TLS is unavailable" IsChecked="{Binding OptionalEncryption}" Margin="0,4"/>
    </StackPanel>
    <ProgressBar IsIndeterminate="{Binding Busy}" Height="4" Margin="0,12"/>
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionStatus"/>
    <Border Background="#FFF1CF" Padding="8" Margin="0,8"><TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" AutomationProperties.AutomationId="TransportWarnings"/></Border>
   </StackPanel></ScrollViewer>
   <WrapPanel Grid.Row="2" Margin="0,12,0,0">
    <Button Content="Save profile" Command="{Binding SaveCommand}" Margin="0,4,6,4" AutomationProperties.AutomationId="SaveProfile"/>
    <Button Content="Test" Command="{Binding TestCommand}" Margin="0,4,6,4" AutomationProperties.AutomationId="TestConnection"/>
    <Button Content="Open" Command="{Binding OpenCommand}" Margin="0,4,6,4" IsDefault="True" AutomationProperties.AutomationId="OpenProfile"/>
    <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="0,4,6,4" AutomationProperties.AutomationId="RemoveProfile"/>
    <Button Content="Initialize database…" Click="InitializeClicked" IsEnabled="{Binding Idle}" Margin="0,4,6,4" AutomationProperties.AutomationId="InitializeDatabase"/>
    <Button Content="Reassociate book…" Click="ReassociateClicked" IsEnabled="{Binding Idle}" Margin="0,4,6,4" AutomationProperties.AutomationId="ReassociateProfile"/>
    <Button Content="Cancel operation" Click="CancelClicked" Margin="0,4,6,4" AutomationProperties.AutomationId="CancelConnection"/>
    <Button Content="Close" Click="CloseClicked" Margin="0,4,6,4"/>
   </WrapPanel>
  </Grid>
 </Grid>
</Window>
