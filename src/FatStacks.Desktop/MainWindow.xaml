<Window x:Class="FatStacks.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FatStacks.Desktop.ViewModels"
        Title="Fat Stacks.NET" Icon="Assets/ApplicationIcon.ico"
        Width="1360" Height="860" MinWidth="960" MinHeight="600"
        FontFamily="Segoe UI" FontSize="13" Background="White"
        AutomationProperties.AutomationId="MainWindow">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Assets/FluentIcons.xaml"/></ResourceDictionary.MergedDictionaries>
   <DataTemplate x:Key="EntrySummaryTemplate">
    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SummaryText}" AutomationProperties.Name="{Binding SummaryText}"><Run Text="{Binding DisplayPayee,Mode=OneWay}"/><Run Text="{Binding SummarySeparator,Mode=OneWay}"/><Run Text="{Binding DisplayDescription,Mode=OneWay}" FontStyle="Italic"/></TextBlock>
   </DataTemplate>
   <Style x:Key="NumericHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="#F2F5F8"/><Setter Property="Foreground" Value="#23384E"/>
    <Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#DCE3EA"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
   </Style>
   <Style x:Key="Money" TargetType="TextBlock">
    <Setter Property="Foreground" Value="#23384E"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
   </Style>
   <Style x:Key="BalanceMoney" TargetType="TextBlock" BasedOn="{StaticResource Money}">
    <Style.Triggers><DataTrigger Binding="{Binding IsNegative}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers>
   </Style>
   <Style x:Key="AccountTabStyle" TargetType="TabItem">
    <Setter Property="Foreground" Value="#748498"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
     <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="0,8,0,6" MinHeight="44">
      <Path x:Name="Icon" Data="{TemplateBinding Tag}" Fill="{TemplateBinding Foreground}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#EDF1F6"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#225B88"/><Setter TargetName="TabBorder" Property="Background" Value="#E5EFF8"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#D58B16"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#225B88"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style>
   <HierarchicalDataTemplate DataType="{x:Type vm:AccountGroup}" ItemsSource="{Binding Children}">
    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
   </HierarchicalDataTemplate>
   <HierarchicalDataTemplate DataType="{x:Type vm:AccountNode}" ItemsSource="{Binding Children}">
    <StackPanel ToolTip="{Binding Path}">
     <TextBlock Text="{Binding Label}"/>
     <TextBlock Text="{Binding BalanceLabel}" FontSize="11" Margin="0,2,0,0">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#748498"/><Style.Triggers><DataTrigger Binding="{Binding IsNegative}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </StackPanel>
   </HierarchicalDataTemplate>
  </ResourceDictionary>
 </Window.Resources>
 <DockPanel>
  <Menu DockPanel.Dock="Top" Background="#F7F9FB" Padding="6,3">
   <MenuItem Header="_File">
    <MenuItem Header="_Connections…" Command="Open" InputGestureText="Ctrl+O"/>
    <MenuItem Header="Set up _accounts…" Click="AccountsClicked" IsEnabled="{Binding IsEnabled,ElementName=AccountSetupButton}"/>
    <MenuItem Header="_Reload" Click="RefreshClicked" InputGestureText="F5" IsEnabled="{Binding IsEnabled,ElementName=ReloadButton}"/>
    <MenuItem x:Name="DisconnectButton" Header="_Disconnect" Click="DisconnectClicked" IsEnabled="False" AutomationProperties.AutomationId="Disconnect"/>
    <Separator/><MenuItem Header="E_xit" Click="ExitClicked"/>
   </MenuItem>
  </Menu>
  <Border DockPanel.Dock="Top" BorderBrush="#DCE3EA" BorderThickness="0,0,0,1" Padding="20,15">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="FAT STACKS.NET" FontSize="11" FontWeight="Bold" Foreground="#748498"/>
     <TextBlock x:Name="BookTitle" Text="Connect to your book" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ActiveBook" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#EDF4EE" CornerRadius="4" Padding="10,6" Margin="0,0,12,0"><TextBlock Text="REGISTER" Foreground="#52725B" FontSize="11" FontWeight="SemiBold"/></Border>
     <Button x:Name="NewJournalButton" Content="_New entry" Click="NewJournalClicked" ToolTip="New entry (N)" AutomationProperties.AutomationId="NewJournal"/>
   <Button x:Name="EditJournalButton" Content="_Edit" Click="EditJournalClicked" ToolTip="Edit selected entry (E)" AutomationProperties.AutomationId="EditJournal"/>
   <Button x:Name="DeleteJournalButton" Content="Delete" Click="DeleteJournalClicked" ToolTip="Delete selected entry (Delete)" AutomationProperties.AutomationId="DeleteJournal"/>
   <Button x:Name="AccountSetupButton" Content="Accounts…" Click="AccountsClicked" IsEnabled="False" AutomationProperties.AutomationId="SetupAccounts"/>
     <Button Content="Connections…" Click="ConnectionsClicked" AutomationProperties.AutomationId="Connections"/>
     <Button x:Name="ReloadButton" Content="Reload" Click="RefreshClicked" IsEnabled="False" AutomationProperties.AutomationId="RefreshRegister"/>
    </StackPanel>
   </Grid>
  </Border>
  <StatusBar DockPanel.Dock="Bottom" Background="#F7F9FB" Padding="12,6">
   <Grid Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=StatusBar}}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" ClipToBounds="True"><TextBlock x:Name="Status" Text="Choose a saved database connection." AutomationProperties.AutomationId="MainStatus"/>
     <TextBlock Text="{Binding DataContext.AccountSummary,ElementName=Workspace}" Margin="12,0,0,0" Foreground="#748498"/>
     <TextBlock Text="{Binding DataContext.Status,ElementName=Workspace}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="RegisterStatus"/>
    </StackPanel>
    <TextBlock Grid.Column="1" x:Name="BookIdentity" FontSize="11" Foreground="#748498" MaxWidth="420" Margin="16,0,24,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" AutomationProperties.AutomationId="BookIdentity"/>
   </Grid>
  </StatusBar>
  <Grid x:Name="Workspace">
   <Grid.ColumnDefinitions><ColumnDefinition Width="290" MinWidth="210"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel Background="#F8FAFC">
    <TabControl DockPanel.Dock="Top" SelectedIndex="{Binding GroupIndex}" BorderThickness="0" Background="Transparent"
                ItemContainerStyle="{StaticResource AccountTabStyle}" KeyboardNavigation.TabNavigation="Once"
                AutomationProperties.Name="Account groups" AutomationProperties.AutomationId="AccountGroups">
     <TabControl.Template><ControlTemplate TargetType="TabControl"><UniformGrid Rows="1" IsItemsHost="True"/></ControlTemplate></TabControl.Template>
     <TabItem Header="Banks" ToolTip="Banks" AutomationProperties.Name="Banks"><TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource AccountTabStyle}"><Setter Property="Tag" Value="{StaticResource BanksRegular}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Tag" Value="{StaticResource BanksFilled}"/></Trigger></Style.Triggers></Style></TabItem.Style></TabItem>
     <TabItem Header="Credit Cards" ToolTip="Credit Cards" AutomationProperties.Name="Credit Cards"><TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource AccountTabStyle}"><Setter Property="Tag" Value="{StaticResource CreditCardsRegular}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Tag" Value="{StaticResource CreditCardsFilled}"/></Trigger></Style.Triggers></Style></TabItem.Style></TabItem>
     <TabItem Header="Investments" ToolTip="Investments" AutomationProperties.Name="Investments"><TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource AccountTabStyle}"><Setter Property="Tag" Value="{StaticResource InvestmentsRegular}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Tag" Value="{StaticResource InvestmentsFilled}"/></Trigger></Style.Triggers></Style></TabItem.Style></TabItem>
     <TabItem Header="Loans Payable" ToolTip="Loans Payable" AutomationProperties.Name="Loans Payable"><TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource AccountTabStyle}"><Setter Property="Tag" Value="{StaticResource LoansPayableRegular}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Tag" Value="{StaticResource LoansPayableFilled}"/></Trigger></Style.Triggers></Style></TabItem.Style></TabItem>
     <TabItem Header="Other" ToolTip="Other" AutomationProperties.Name="Other"><TabItem.Style><Style TargetType="TabItem" BasedOn="{StaticResource AccountTabStyle}"><Setter Property="Tag" Value="{StaticResource OtherRegular}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Tag" Value="{StaticResource OtherFilled}"/></Trigger></Style.Triggers></Style></TabItem.Style></TabItem>
    </TabControl>
    <Border DockPanel.Dock="Top" Padding="18,14,18,12"><TextBlock Text="{Binding GroupTitle,FallbackValue=BANKS}" Foreground="#748498" FontWeight="SemiBold" FontSize="11"/></Border>
    <Grid>
     <TreeView x:Name="AccountTree" ItemsSource="{Binding VisibleTree}" SelectedItemChanged="AccountChanged" BorderThickness="0" Background="Transparent" Padding="8,0,8,12" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="AccountTree">
      <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="Padding" Value="5,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="IsExpanded" Value="True"/>
       <Style.Triggers><DataTrigger Binding="{Binding IsAccount}" Value="True"><Setter Property="IsSelected" Value="{Binding IsSelected,Mode=TwoWay}"/><Setter Property="AutomationProperties.Name" Value="{Binding Label}"/></DataTrigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#F5A623"/><Setter Property="Foreground" Value="#23384E"/></Trigger></Style.Triggers>
      </Style></TreeView.ItemContainerStyle>
     </TreeView>
     <TextBlock Text="No accounts in this group." Foreground="#748498" TextWrapping="Wrap" Margin="18,8" VerticalAlignment="Top" IsHitTestVisible="False">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tree.Count,FallbackValue=0}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
   </DockPanel>
   <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E4EAF0"/>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Padding="20,18" BorderBrush="#DFE6EC" BorderThickness="0,0,0,1">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock AutomationProperties.AutomationId="RegisterAccountTitle" Text="{Binding AccountTitle,FallbackValue=Transaction register}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding AccountPath,FallbackValue=Select an account to view its transactions}" Foreground="#748498" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="CURRENT BALANCE" FontSize="10" Foreground="#748498" HorizontalAlignment="Right"/><TextBlock Text="{Binding BalanceLabel,FallbackValue=—}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" TextAlignment="Right" Typography.NumeralAlignment="Tabular" AutomationProperties.AutomationId="CurrentBalance"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#23384E"/><Style.Triggers><DataTrigger Binding="{Binding IsBalanceNegative}" Value="True"><Setter Property="Foreground" Value="#B42318"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
     </Grid>
    </Border>
    <Border Grid.Row="1" Background="#F2F5F8" Padding="16,10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#F8EDD3" BorderBrush="#E7D5A9" BorderThickness="1" CornerRadius="3" Padding="12,5"><TextBlock Text="Showing: Last 90 days"/></Border><TextBlock Text="{Binding Rows.Count,StringFormat={}{0:N0} transactions,FallbackValue=0 transactions}" Foreground="#748498" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel>
      <TextBox x:Name="RegisterSearch" Grid.Column="1" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" VerticalContentAlignment="Center" BorderBrush="#CFD8E1" ToolTip="Search descriptions and counter-accounts (Ctrl+F)" AutomationProperties.Name="Search transactions" AutomationProperties.AutomationId="RegisterSearch"/>
     </Grid>
    </Border>
    <Grid Grid.Row="2">
     <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected,Mode=OneWay}" SelectionChanged="RegisterSelectionChanged" MouseDoubleClick="RegisterDoubleClicked" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False"
               SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Vertical" VerticalGridLinesBrush="#E4EAF0" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#F0F8FC" Background="#F0F0F0"
               HeadersVisibility="Column" RowHeight="34" EnableRowVirtualization="True" EnableColumnVirtualization="True" AutomationProperties.AutomationId="RegisterGrid">
      <DataGrid.Resources><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DDEBFA"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#23384E"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E8EEF5"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#23384E"/></DataGrid.Resources>
      <DataGrid.Columns>
       <DataGridTextColumn Header="Date" Binding="{Binding Date,StringFormat=yyyy-MM-dd}" Width="105"/>
       <DataGridTemplateColumn Header="Payee / Description" CellTemplate="{StaticResource EntrySummaryTemplate}" Width="2*"/>
       <DataGridTextColumn Header="Category" Binding="{Binding CounterAccounts}" Width="1.4*"/>
       <DataGridTemplateColumn Header="C" Width="35"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock ToolTip="{Binding Status}" AutomationProperties.Name="{Binding Status}" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value=""/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Cleared"><Setter Property="Text" Value="✓"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Reconciling"><Setter Property="Text" Value="R"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Mixed"><Setter Property="Text" Value="M"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Binding="{Binding Payment,StringFormat=N2}" Width="125" ElementStyle="{StaticResource Money}" HeaderStyle="{StaticResource NumericHeader}"><DataGridTextColumn.Header><TextBlock Text="Payment" ToolTip="Net credits to the selected account"/></DataGridTextColumn.Header></DataGridTextColumn>
       <DataGridTextColumn Binding="{Binding Deposit,StringFormat=N2}" Width="125" ElementStyle="{StaticResource Money}" HeaderStyle="{StaticResource NumericHeader}"><DataGridTextColumn.Header><TextBlock Text="Deposit" ToolTip="Net debits to the selected account"/></DataGridTextColumn.Header></DataGridTextColumn>
       <DataGridTextColumn Header="Balance" Binding="{Binding Balance,StringFormat=N2}" Width="145" ElementStyle="{StaticResource BalanceMoney}" HeaderStyle="{StaticResource NumericHeader}"/>
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="30">
      <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count,FallbackValue=0}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
      <TextBlock Text="{Binding EmptyTitle,FallbackValue=Connect to your book}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding EmptyDescription,FallbackValue=Use Connections to open a book.}" Foreground="#748498" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
     </StackPanel>
    </Grid>
    <Border Grid.Row="3" BorderBrush="#DCE3EA" BorderThickness="0,1,0,0" Background="#FAFBFD" Padding="18,12">
     <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Selected,FallbackValue={x:Null}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <StackPanel><DockPanel><ContentControl Content="{Binding Selected}" ContentTemplate="{StaticResource EntrySummaryTemplate}" Focusable="False" IsTabStop="False"/><TextBlock Text="{Binding Currency}" Margin="12,0,0,0" Foreground="#748498"/></DockPanel>
      <DataGrid ItemsSource="{Binding Details}" MaxHeight="180" Margin="0,6" Background="Transparent" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" RowHeight="30" EnableRowVirtualization="True" EnableColumnVirtualization="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="EntryDetails">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Account" Width="2*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><Hyperlink Click="DetailAccountClicked" Tag="{Binding AccountId}" ToolTip="Open this account"><Run Text="{Binding AccountName}"/></Hyperlink></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Header="Debit" Binding="{Binding Debit,StringFormat=N2}" Width="110" ElementStyle="{StaticResource Money}" HeaderStyle="{StaticResource NumericHeader}"/>
        <DataGridTextColumn Header="Credit" Binding="{Binding Credit,StringFormat=N2}" Width="110" ElementStyle="{StaticResource Money}" HeaderStyle="{StaticResource NumericHeader}"/>
        <DataGridTextColumn Header="Status" Binding="{Binding StatusName}" Width="100"/>
        <DataGridTextColumn Header="Security" Binding="{Binding SecurityId}" Width="75"/>
        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="110" ElementStyle="{StaticResource Money}"/>
       </DataGrid.Columns>
      </DataGrid>
      <TextBlock AutomationProperties.AutomationId="SelectedJournalEntry" Text="{Binding Selected.EntryId,StringFormat=Journal entry {0}}" Foreground="#748498" FontSize="11"/>
     </StackPanel>
    </Border>
    <Border Grid.Row="4" Background="#FFF4D9" Padding="14,8">
     <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=Warning}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <DockPanel><Button x:Name="DismissWarning" DockPanel.Dock="Right" Content="Dismiss" Click="DismissWarningClicked" AutomationProperties.AutomationId="DismissSessionWarning"/><TextBlock x:Name="Warning" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="SessionWarning"/></DockPanel>
    </Border>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
